{
  "name": "seityou-apuri",
  "private": true,
  "version": "1.0.0",
  "description": "クエストをこなして成長する、あなただけの冒険者ステータス管理アプリ",
  "author": "seityou-apuri",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:standalone": "tsc -b && vite build --config vite.config.standalone.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "npm run build:standalone && electron .",
    "electron:build:linux": "npm run build:standalone && electron-builder --linux",
    "electron:build:win": "npm run build:standalone && electron-builder --win",
    "electron:build": "npm run build:standalone && electron-builder --linux --win"
  },
  "build": {
    "appId": "app.growthquest.seityou",
    "productName": "成長の書",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist-standalone/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icons/icon-512.png",
      "category": "Utility"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "ksmhrt1610-wq",
      "repo": "seityou-apuri"
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
